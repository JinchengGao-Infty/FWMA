# FWMA — API Keys Configuration
# Copy this file to .env and fill in your keys.
# At minimum, you need ONE of these to get started.

# ── API Keys ──────────────────────────────────────────────────────────

# Google Gemini (used for screening, parliament chair, PDF vision)
GEMINI_API_KEY=

# Anthropic Claude (used as parliament member)
ANTHROPIC_API_KEY=

# OpenAI GPT (used as parliament member)
OPENAI_API_KEY=

# ── Custom Base URLs (optional) ───────────────────────────────────────
# Override default API endpoints for proxies or compatible services.
# Leave empty to use official defaults.

# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_OPENAI_BASE_URL=

# ── Other ─────────────────────────────────────────────────────────────

# Optional: OpenAlex polite pool (faster rate limits)
# OPENALEX_MAILTO=your@email.com
