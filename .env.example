# FWMA — API Keys Configuration
# Copy this file to .env and fill in your keys.
# At minimum, you need ONE of these to get started.

# Google Gemini (recommended — used for screening, parliament chair, PDF vision)
GEMINI_API_KEY=

# Anthropic Claude (used as parliament member)
ANTHROPIC_API_KEY=

# OpenAI GPT (used as parliament member)
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (for local models, vLLM, etc.)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# Optional: OpenAlex polite pool (faster rate limits)
# OPENALEX_MAILTO=your@email.com
